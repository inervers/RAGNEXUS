# ==========================================
# RAG Agent API — 环境变量模板
# 复制为 .env 并填写真实值后再启动
# ==========================================

# DeepSeek API Key（主用，必填；当前模型 deepseek-v4-flash）
# 注册：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-your-key-here

# 智谱 GLM API Key（fallback 备用；免费 glm-4.7-flash，但高峰限流、可能空回复）
# 注册：https://open.bigmodel.cn → API Keys
ZHIPU_API_KEY=sk-your-key-here

# LLM 端点与模型（默认 DeepSeek，可替换任意 OpenAI 兼容服务）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# API 鉴权密钥（必填；请生成独立随机值，复制模板占位符会被拒绝启动）
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=replace-with-a-random-secret

# 浏览器 CORS 精确 origin，逗号分隔；禁止使用 *
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# 速率限制（次/分钟）
RAG_RATE_LIMIT=30

# V2 为默认生产路径。以下值已由 Docker/manifest 固定，通常无需取消注释。
# 本地直接运行 rag_api.py 时，会默认读取仓库内 .rag06-models 与 tracked manifest。
# RAG_CHROMA_HOST_DIR=./chroma_db_v2_candidate
# RAG_EMBEDDING_MODEL_SOURCE=.rag06-models/multilingual-minilm-l12-v2
# RAG_EMBEDDING_MANIFEST=models/manifests/paraphrase-multilingual-MiniLM-L12-v2.json
# RAG_EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_EMBEDDING_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# RAG_EMBEDDING_POOLING=masked_mean

# ==========================================
# 百度 OCR（可选，扫描件 PDF 自动识别）
# 在百度智能云 → 文字识别 → 创建应用
# ==========================================
BAIDU_OCR_API_KEY=your-api-key-here
BAIDU_OCR_SECRET_KEY=your-secret-key-here
