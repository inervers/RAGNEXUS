# ==========================================
# RAG Agent API — 环境变量模板
# 复制为 .env 并填写真实值后再启动
# ==========================================

# 智谱 GLM API Key（必填，推荐免费 glm-4.7-flash）
# 注册：https://open.bigmodel.cn → API Keys
ZHIPU_API_KEY=sk-your-key-here

# LLM 端点与模型（默认智谱免费版，可替换任意 OpenAI 兼容服务）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.7-flash

# 旧配置兼容：若未填 ZHIPU_API_KEY，会回退读 DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# API 鉴权密钥（默认 rag-secret-key-2024）
RAG_API_KEY=rag-secret-key-2024

# 速率限制（次/分钟）
RAG_RATE_LIMIT=30

# ==========================================
# 百度 OCR（可选，扫描件 PDF 自动识别）
# 在百度智能云 → 文字识别 → 创建应用
# ==========================================
BAIDU_OCR_API_KEY=your-api-key-here
BAIDU_OCR_SECRET_KEY=your-secret-key-here
