# ==========================================
# RAG Agent API — 环境变量模板
# 复制为 .env 并填写真实值后再启动
# ==========================================

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# API 鉴权密钥（默认 rag-secret-key-2024）
RAG_API_KEY=rag-secret-key-2024

# 速率限制（次/分钟）
RAG_RATE_LIMIT=30

# ==========================================
# 百度 OCR（可选，扫描件 PDF 自动识别）
# 在百度智能云 → 文字识别 → 创建应用
# ==========================================
BAIDU_OCR_API_KEY=REMOVED
BAIDU_OCR_SECRET_KEY=REMOVED
